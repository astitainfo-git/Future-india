PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_NAME=futureindiaexpo
DB_USER=root
DB_PASSWORD=

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Leave empty to skip reCAPTCHA verification in local development
RECAPTCHA_SECRET=

# Copy of the PHP site's public/assets folder (theme CSS/JS, logo, product and banner images).
# Served at /assets; admin uploads are written into it, in the same folders Store.php used.
ASSETS_DIR=assets

# Production only: path to the client's `npm run build` output, served from this same origin.
CLIENT_DIST=

# ---- Image storage (Cloudflare R2 / Amazon S3) ----
# With these set, admin uploads go to the bucket instead of the app's disk, which the host
# wipes on every deploy. Leave empty locally to keep using the assets folder.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public address of the bucket, e.g. https://images.yourdomain.com or the R2 public URL.
ASSET_PUBLIC_URL=
